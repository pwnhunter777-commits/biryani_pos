{
  "entities": {
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "Menu items available in the biryani shop catalog",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the catalog item"
        },
        "name": {
          "type": "string",
          "description": "Name of the dish or menu item"
        },
        "price": {
          "type": "number",
          "description": "Base price of the item"
        },
        "pricingType": {
          "type": "string",
          "description": "Pricing model: fixed, gram, or plate"
        },
        "weightKg": {
          "type": "number",
          "description": "Calculated weight in kilograms"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last update timestamp in milliseconds"
        }
      },
      "required": ["id", "name", "price", "pricingType"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Customer order bill generated by employee or owner",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique bill ID"
        },
        "billNumber": {
          "type": "string",
          "description": "Human-readable bill invoice number"
        },
        "timestamp": {
          "type": "number",
          "description": "Timestamp when bill was generated"
        },
        "dateString": {
          "type": "string",
          "description": "Date formatted as YYYY-MM-DD"
        },
        "timeString": {
          "type": "string",
          "description": "Time formatted as HH:MM:SS"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total bill amount"
        },
        "totalQuantity": {
          "type": "number",
          "description": "Total count of items"
        },
        "employeePinUsed": {
          "type": "string",
          "description": "PIN of the employee who created the bill"
        },
        "printCount": {
          "type": "number",
          "description": "Number of times this bill was printed"
        }
      },
      "required": ["id", "billNumber", "timestamp", "dateString", "totalAmount", "totalQuantity"]
    },
    "ShopSettings": {
      "title": "ShopSettings",
      "description": "Shop profile and billing configuration",
      "type": "object",
      "properties": {
        "shopName": {
          "type": "string",
          "description": "Name of the restaurant or biryani shop"
        },
        "tagline": {
          "type": "string",
          "description": "Tagline or slogan"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "address": {
          "type": "string",
          "description": "Shop street address"
        },
        "footerNote": {
          "type": "string",
          "description": "Receipt bottom message"
        },
        "ownerPin": {
          "type": "string",
          "description": "Secret PIN for owner dashboard"
        },
        "employeePin": {
          "type": "string",
          "description": "Secret PIN for employee billing portal"
        },
        "paperWidth": {
          "type": "string",
          "description": "Thermal printer width (58mm or 80mm)"
        },
        "ownerWhatsApp": {
          "type": "string",
          "description": "Owner WhatsApp number for daily reports"
        }
      },
      "required": ["shopName", "ownerPin", "employeePin"]
    },
    "OwnerSharedDailyReport": {
      "title": "OwnerSharedDailyReport",
      "description": "Daily end-of-day sales summary report submitted to the database",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique report ID"
        },
        "dateString": {
          "type": "string",
          "description": "Date of the report YYYY-MM-DD"
        },
        "sharedAt": {
          "type": "number",
          "description": "Timestamp when shared"
        },
        "sharedTime": {
          "type": "string",
          "description": "Formatted time when shared"
        },
        "totalBills": {
          "type": "number",
          "description": "Total bills completed on this date"
        },
        "totalSales": {
          "type": "number",
          "description": "Total revenue for the day"
        },
        "totalItemsSold": {
          "type": "number",
          "description": "Total portion items sold"
        }
      },
      "required": ["id", "dateString", "sharedAt", "totalBills", "totalSales", "totalItemsSold"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": "CatalogItem",
      "description": "Menu items catalog"
    },
    "/bills/{billId}": {
      "schema": "Bill",
      "description": "Customer sales bills"
    },
    "/settings/{settingId}": {
      "schema": "ShopSettings",
      "description": "Shop configuration document"
    },
    "/dailyReports/{reportId}": {
      "schema": "OwnerSharedDailyReport",
      "description": "End-of-day sales reports"
    }
  }
}
